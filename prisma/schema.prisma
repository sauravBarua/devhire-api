generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  EXPIRED
}

enum JobCategory {
  FRONTEND
  BACKEND
  FULLSTACK
  DEVOPS
  QA
  MOBILE
}

enum ContractType {
  CDI
  CDD
  STAGE
  ALTERNANCE
  FREELANCE
}

enum RemotePolicy {
  FULL_REMOTE
  HYBRID
  ON_SITE
}

enum ExperienceLevel {
  JUNIOR
  MID
  SENIOR
}

enum ApplicationStatus {
  NEW
  REVIEWED
  INTERVIEW
  REJECTED
  HIRED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  company       Company?
  applications  Application[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model Company {
  id           String   @id @default(uuid())
  ownerId      String   @unique
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  slug         String   @unique
  description  String?
  website      String?
  city         String?
  logoPublicId String?
  logoUrl      String?
  logoSize     Int?
  logoMime     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  jobs         Job[]
}

model Skill {
  id        String     @id @default(uuid())
  slug      String     @unique
  name      String     @unique
  aliases   String[]   @default([])
  createdAt DateTime   @default(now())
  jobs      JobSkill[]
}

model Job {
  id              String          @id @default(uuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title           String
  description     String
  category        JobCategory
  contractType    ContractType
  remotePolicy    RemotePolicy
  experienceLevel ExperienceLevel
  city            String?
  region          String?
  salaryMin       Int?
  salaryMax       Int?
  status          JobStatus       @default(DRAFT)
  publishedAt     DateTime?
  expiresAt       DateTime?
  closedAt        DateTime?
  searchVector    Unsupported("tsvector")?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  skills          JobSkill[]
  applications    Application[]

  @@index([status, publishedAt])
  @@index([status, expiresAt])
  @@index([companyId])
  @@index([searchVector], type: Gin)
}

model JobSkill {
  jobId   String
  skillId String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@index([skillId])
}

model Application {
  id          String            @id @default(uuid())
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   User              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(NEW)
  coverLetter String?
  cvPublicId  String
  cvUrl       String
  cvSize      Int
  cvMime      String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([jobId, candidateId])
  @@index([candidateId, createdAt])
  @@index([jobId, status])
}