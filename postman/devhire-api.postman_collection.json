{
  "info": {
    "name": "DevHire API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "candidateAccessToken", "value": "" },
    { "key": "recruiterAccessToken", "value": "" },
    { "key": "adminAccessToken", "value": "" },
    { "key": "candidateId", "value": "" },
    { "key": "recruiterId", "value": "" },
    { "key": "companyId", "value": "" },
    { "key": "companySlug", "value": "" },
    { "key": "candidateEmail", "value": "candidatea@devhire.test" },
    { "key": "recruiterEmail", "value": "recruitera@devhire.test" },
    { "key": "adminEmail", "value": "admin@devhire.test" },
    { "key": "testPassword", "value": "Passw0rd!dev" },
    { "key": "adminPassword", "value": "Admin#Dev12345" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Live",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": ["{{baseUrl}}"],
              "path": ["health", "live"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));",
                  "pm.test('x-request-id header present', () => pm.response.to.have.header('x-request-id'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ready",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": ["{{baseUrl}}"],
              "path": ["health", "ready"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('db and redis up', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.checks.database).to.eql('up');",
                  "  pm.expect(body.checks.redis).to.eql('up');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register candidateA",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{candidateEmail}}\",\"password\":\"{{testPassword}}\",\"firstName\":\"Alice\",\"lastName\":\"Candidate\",\"role\":\"CANDIDATE\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 created, or 409 if already registered', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register recruiterA",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{recruiterEmail}}\",\"password\":\"{{testPassword}}\",\"firstName\":\"Robert\",\"lastName\":\"Recruiter\",\"role\":\"RECRUITER\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 created, or 409 if already registered', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin (seeded)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('role is ADMIN', () => pm.expect(json.user.role).to.eql('ADMIN'));",
                  "pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.collectionVariables.set('adminAccessToken', json.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login recruiterA",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{recruiterEmail}}\",\"password\":\"{{testPassword}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('role is RECRUITER', () => pm.expect(json.user.role).to.eql('RECRUITER'));",
                  "pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.collectionVariables.set('recruiterAccessToken', json.accessToken);",
                  "pm.collectionVariables.set('recruiterId', json.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login candidateA",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{candidateEmail}}\",\"password\":\"{{testPassword}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('role is CANDIDATE', () => pm.expect(json.user.role).to.eql('CANDIDATE'));",
                  "pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.collectionVariables.set('candidateAccessToken', json.accessToken);",
                  "pm.collectionVariables.set('candidateId', json.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns the logged-in user', () => pm.expect(pm.response.json().email).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh (cookie)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
                  "pm.test('rotated refresh cookie set', () => pm.expect(pm.cookies.has('refresh_token')).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Companies",
      "item": [
        {
          "name": "Create company (recruiterA)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{recruiterAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Acme Studio\",\"description\":\"Agence web fictive pour les tests.\",\"website\":\"https://acme.example.com\",\"city\":\"Paris\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/companies",
              "host": ["{{baseUrl}}"],
              "path": ["companies"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 created, or 409 if recruiterA already has a company', () => pm.expect([201, 409]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('companyId', json.id);",
                  "  pm.collectionVariables.set('companySlug', json.slug);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get my company (recruiterA)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{recruiterAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/companies/me",
              "host": ["{{baseUrl}}"],
              "path": ["companies", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('companyId', json.id);",
                  "pm.collectionVariables.set('companySlug', json.slug);",
                  "pm.test('has a slug', () => pm.expect(json.slug).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update my company (recruiterA)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{recruiterAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"city\":\"Lyon\",\"description\":\"Agence web fictive, mise à jour.\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/companies/me",
              "host": ["{{baseUrl}}"],
              "path": ["companies", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('city updated', () => pm.expect(pm.response.json().city).to.eql('Lyon'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload logo (recruiterA)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{recruiterAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": [] }]
            },
            "url": {
              "raw": "{{baseUrl}}/companies/me/logo",
              "host": ["{{baseUrl}}"],
              "path": ["companies", "me", "logo"]
            },
            "description": "Select a PNG, JPEG or WebP file (max 2 MB) in the 'file' field. Needs Cloudinary values in .env, otherwise 503 UPLOADS_NOT_CONFIGURED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK, or 503 when Cloudinary is not configured', () => pm.expect([200, 503]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) {",
                  "  pm.test('logoUrl is set', () => pm.expect(pm.response.json().logoUrl).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Candidate cannot create a company",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{candidateAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"Should Fail\"}" },
            "url": {
              "raw": "{{baseUrl}}/companies",
              "host": ["{{baseUrl}}"],
              "path": ["companies"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));",
                  "pm.test('error code', () => pm.expect(pm.response.json().code).to.eql('AUTH_FORBIDDEN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get company by slug (public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/companies/{{companySlug}}",
              "host": ["{{baseUrl}}"],
              "path": ["companies", "{{companySlug}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('slug matches', () => pm.expect(pm.response.json().slug).to.eql(pm.collectionVariables.get('companySlug')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Skills",
      "item": [
        {
          "name": "List skills (public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/skills",
              "host": ["{{baseUrl}}"],
              "path": ["skills"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const skills = pm.response.json();",
                  "pm.test('seeded skills are returned', () => pm.expect(skills.length).to.be.above(20));",
                  "pm.test('Node.js carries its aliases', () => {",
                  "  const node = skills.find((s) => s.slug === 'nodejs');",
                  "  pm.expect(node.aliases).to.include('node');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
