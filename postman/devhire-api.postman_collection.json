        {
          "name": "Publish job (DRAFT -> PUBLISHED)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{recruiterAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recruiter/jobs/{{jobId}}/publish",
              "host": ["{{baseUrl}}"],
              "path": ["recruiter", "jobs", "{{jobId}}", "publish"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('PUBLISHED', () => pm.expect(json.status).to.eql('PUBLISHED'));",
                  "pm.test('expiresAt is 30 days after publishedAt', () => {",
                  "  const diff = new Date(json.expiresAt) - new Date(json.publishedAt);",
                  "  pm.expect(diff).to.eql(30 * 24 * 60 * 60 * 1000);",
                  "});",
                  "pm.collectionVariables.set('jobPublishedAt', json.publishedAt);",
                  "pm.collectionVariables.set('jobExpiresAt', json.expiresAt);"
                ]
              }
