NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://devhire:devhire@localhost:5432/devhire?schema=public
REDIS_URL=redis://localhost:6379
JOB_DEFAULT_EXPIRY_DAYS=30
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=10
SEED_ADMIN_EMAIL=admin@devhire.test
SEED_ADMIN_PASSWORD="Admin#Dev12345"
# Cloudinary (optional until you test uploads; keep real values only in your own .env)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Email (defaults match the MailHog container from docker-compose)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DevHire <no-reply@devhire.test>"
WEB_URL=http://localhost:3001
JOB_EXPIRY_REMINDER_DAYS=3
QUEUE_BACKOFF_MS=5000