    {
      "name": "Jobs (recruiter)",
      "item": [
        {
          "name": "Create job (recruiterA)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{recruiterAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Développeur Node.js senior\",\"description\":\"Rejoignez une équipe produit pour construire des API fiables et maintenables.\",\"category\":\"BACKEND\",\"contractType\":\"CDI\",\"remotePolicy\":\"HYBRID\",\"experienceLevel\":\"SENIOR\",\"city\":\"Paris\",\"salaryMin\":50000,\"salaryMax\":70000,\"skills\":[\"nodejs\",\"typescript\"]}"
            },
            "url": {
              "raw": "{{baseUrl}}/recruiter/jobs",
              "host": ["{{baseUrl}}"],
